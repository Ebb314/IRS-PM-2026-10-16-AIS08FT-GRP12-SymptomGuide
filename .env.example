# Set these in PowerShell, or pass --env-file .env to uvicorn.
REASONING_MODE=random
NLP_ENGINE=rules
NLP_USE_TRANSFORMERS=false
TEAMMATE_API_URL=http://127.0.0.1:8010
ADAPTER_TIMEOUT_SECONDS=3
# Optional local Ollama: install a model separately, then set NLP_ENGINE=ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=


# Real local LLM + dense retrieval; default remains offline.
AI_PROFILE=offline
# AI_PROFILE=local requires models downloaded and requirements-local.txt + PyTorch.
# LOCAL_MODEL_PATH=E:/Study/StudyAtNUS/GC1_Project/models/Qwen2.5-1.5B-Instruct
# EMBEDDING_MODEL_PATH=E:/Study/StudyAtNUS/GC1_Project/models/all-MiniLM-L6-v2


# Full CSV is now the default vocabulary; set an absolute path to override it.
# KG_NODE_FILE=E:/Study/StudyAtNUS/GC1_Project/backend/app/data/kg_nodes.csv
RANDOM_SEED=20260915
# Keep old DEMO sessions separate from full-catalog sessions.
# SESSION_DB=E:/Study/StudyAtNUS/GC1_Project/backend/runtime/sessions-fullkg.sqlite3
